{
	"appId": "com.girirajpower.buildnow",
	"appName": "BuildNow",
	"webDir": "dist",
	"plugins": {
		"App": {},
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#020617",
			"androidSplashResourceName": "splash",
			"androidScaleType": "CENTER_CROP",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#020617"
		}
	},
	"packageClassList": [
		"AppPlugin",
		"PreferencesPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
